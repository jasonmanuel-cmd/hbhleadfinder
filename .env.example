# Postgres connection for the least-privilege dashboard role (Supabase transaction pooler, port 6543)
DATABASE_URL=postgresql://hbh_dashboard.<project-ref>:<password>@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# Shared dashboard password + random secret used to sign the session cookie
DASHBOARD_PASSWORD=
SESSION_SECRET=
# Local Postgres without TLS only
# PGSSLMODE=disable
